# Server-side only. Do NOT prefix with VITE_ — that would bundle it into the
# frontend JS and expose it to anyone viewing the page source.
# Get a key from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Client-side (VITE_ prefix is intentional — the anon key is public by design;
# row-level security protects the data). Supabase dashboard -> Project Settings
# -> API. Leave blank to run on localStorage only.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side only. Do NOT prefix with VITE_ — that would bundle it into the
# frontend JS and expose it to anyone viewing the page source.
# Get a key from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Client-side Firebase Auth config. These values are intended for the browser.
# Get them from Firebase Console > Project settings > General > Your apps.
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id_optional

# Server-side Firebase Admin token verification.
# Must match VITE_FIREBASE_PROJECT_ID.
FIREBASE_PROJECT_ID=your_firebase_project_id

# Client-side Supabase storage config. The anon key is public by design; row-level
# security protects the data. Leave blank to run on localStorage only.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
